--==============================================================
local function EnsureAlive()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then PlayerGui = pg end

    -- TRIG: bangun ulang kalau terhapus / PlayerGui diganti / disembunyikan
    local trigOk = TrigGui and TrigGui.Parent == PlayerGui and triggerTarget and triggerTarget.Parent == TrigGui
    if not trigOk then
        BuildTrig()
    else
        if not TrigGui.Enabled then TrigGui.Enabled = true end
        if triggerTarget.Visible ~= Config.TrigShow then
            triggerTarget.Visible = Config.TrigShow
        end
    end

    if dbgGui and dbgGui.Parent ~= PlayerGui then
        pcall(function() dbgGui.Parent = PlayerGui end)
    end

    -- MAIN GUI: pasang ulang / bangun ulang kalau terhapus
    if not ScreenGui or not ScreenGui.Parent then
        local ok = pcall(function() ScreenGui.Parent = CoreGui end)
        if not ok or not ScreenGui.Parent then
            local mv, fv = true, false
            pcall(function() mv, fv = Main.Visible, FloatBtn.Visible end)
            BuildMain(mv, fv)
        end
    elseif ScreenGui.Enabled == false then
        ScreenGui.Enabled = true
    end

    UpdateScale()
end

track(LocalPlayer.CharacterAdded:Connect(function()
    releaseTouch()
    lastParry = 0
    inArea, wasIn = false, false
    task.defer(function() pcall(EnsureAlive) end)
end))

track(LocalPlayer.ChildAdded:Connect(function(c)
    if c:IsA("PlayerGui") then
        task.defer(function() pcall(EnsureAlive) end)
    end
end))

task.spawn(function()
    while scriptRunning do
        task.wait(0.5)
        pcall(EnsureAlive)
    end
end)

