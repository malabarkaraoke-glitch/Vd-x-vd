local lastTryLog, lastFailLog = 0, 0
local function tryParry()
    local now = os.clock()
    if now - lastParry < PARRY_GAP then return false end
    if selfBad() then return false end
    -- hadap killer dulu (juga kalau killer di belakang), baru tekan parry
    if Config.FaceEnabled then pcall(faceKiller) end
    if now - lastTryLog > 0.4 then
        lastTryLog = now
        AddLog("[PARRY] Mencoba menekan (" .. string.upper(Config.PressMode) .. ")...", C_INFO)
    end
    if not pressParry() then
        if now - lastFailLog > 1 then
            lastFailLog = now
            AddLog("[WARN] Tekan gagal (TRIG hilang / di luar layar / tombol tidak ketemu).", C_WARN)
        end
        return false
    end
    lastParry = now
    if Config.PressMode == "sinyal" then
        AddLog("[PARRY] Sinyal + TRIG terkirim.", C_OK)
    end
    if UIS.TouchEnabled and hookedBtn then
        local tp = tapT
        task.delay(0.12, function()
            if gameHitT >= tp then
                AddLog("[TRIG] Sentuhan diterima tombol game.", C_OK)
            elseif Config.PressMode ~= "sinyal" then
                AddLog("[TRIG] Sentuhan TIDAK sampai ke tombol game!", C_ERR)
            end
        end)
    end
    if DOUBLE_PRESS then
        task.spawn(function()
            task.wait(TOUCH_HOLD + 0.01)
            if Config.AutoParryEnabled then pressParry() end
        end)
    end
    return true
end

local function handleTrack(t)
    if t.Looped or playDone[t] then return end
    local id = t.Animation and t.Animation.AnimationId
    if not id then return end
    local tp = t.TimePosition
    if not attackAnims[id] then
        if tp <= ANIM_MAX_TP and not seenUnknown[id] then
            seenUnknown[id] = true
            AddLog("[ANIM] Tak dikenal: " .. (string.match(id, "%d+") or id), C_WARN)
        end
        return
    end
    if tp > ANIM_MAX_TP then return end
    if tryParry() then playDone[t] = true end
end

local lastErrLog = 0
local function logErr(err)
    local now = os.clock()
    if now - lastErrLog > 1 then
        lastErrLog = now
        AddLog("[ERROR] " .. tostring(err), C_ERR)
    end
end

local function parryStep()
    -- penjaga: sentuhan tidak boleh nyangkut
    if tapHeld and os.clock() - tapT > TOUCH_HOLD + 0.05 then releaseTouch("paksa") end
    inArea = false
    if not Config.AutoParryEnabled then wasIn = false return end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and isKiller(pl) and pl.Character then
            local ch = pl.Character
            local an = ch:FindFirstChildWhichIsA("Animator", true)
            if an and not hooked[an] then
                hooked[an] = true
                track(an.AnimationPlayed:Connect(function(tk)
                    local ok, err = pcall(function()
                        playDone[tk] = nil
                        lastTP[tk] = 0
                        if Config.AutoParryEnabled and killerInArea(pl) then handleTrack(tk) end
                    end)
                    if not ok then logErr(err) end
                end))
            end
            if killerInArea(pl) then
                inArea = true
                local src = an or ch:FindFirstChildOfClass("Humanoid")
                if src then
                    for _, t in ipairs(src:GetPlayingAnimationTracks()) do
                        local tp = t.TimePosition
                        if tp < (lastTP[t] or 0) - 0.05 then playDone[t] = nil end
                        lastTP[t] = tp
                        handleTrack(t)
                    end
                end
            end
        end
    end
    if inArea and not wasIn then
        AddLog("[SYS] Killer mendekat!", C_WARN)
    end
    wasIn = inArea
end

track(RunService.Stepped:Connect(function()
    local ok, err = pcall(parryStep)
    if not ok then logErr(err) end
end))

