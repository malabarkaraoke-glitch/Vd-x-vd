local RING_SEG = 40
local ringPart, ringAtt, ringBeams, lastR, lastIn
local ringRP = RaycastParams.new()
ringRP.FilterType = Enum.RaycastFilterType.Exclude
local ORANGE, RED = Color3.fromRGB(255, 140, 0), Color3.fromRGB(255, 60, 40)

local function destroyRing()
    if ringPart then ringPart:Destroy() ringPart = nil end
end
local function ensureRing()
    if ringPart and ringPart.Parent then return end
    ringAtt, ringBeams = {}, {}
    ringPart = Instance.new("Part")
    ringPart.Name = "ParryArea"
    ringPart.Anchored = true
    ringPart.CanCollide = false
    ringPart.CanQuery = false
    ringPart.CanTouch = false
    ringPart.CastShadow = false
    ringPart.Transparency = 1
    ringPart.Size = Vector3.new(0.2, 0.2, 0.2)
    ringPart.Parent = Workspace.CurrentCamera or Workspace
    for i = 1, RING_SEG do
        local a = Instance.new("Attachment")
        a.Parent = ringPart
        ringAtt[i] = a
    end
    for i = 1, RING_SEG do
        local b = Instance.new("Beam")
        b.Attachment0 = ringAtt[i]
        b.Attachment1 = ringAtt[(i % RING_SEG) + 1]
        b.FaceCamera = true
        b.Segments = 1
        b.Width0, b.Width1 = 0.22, 0.22
        b.LightEmission = 1
        b.LightInfluence = 0
        b.Color = ColorSequence.new(ORANGE)
        b.Transparency = NumberSequence.new(0.1)
        b.Parent = ringPart
        ringBeams[i] = b
    end
    lastR, lastIn = nil, nil
end

track(RunService.RenderStepped:Connect(function()
    if not (Config.AutoParryEnabled and Config.AreaEnabled) then destroyRing() return end
    local ch = LocalPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local ok, err = pcall(function()
        ensureRing()
        local radius = Config.ParryRadius
        if radius ~= lastR then
            lastR = radius
            for i, a in ipairs(ringAtt) do
                local ang = (i - 1) / RING_SEG * math.pi * 2
                a.Position = Vector3.new(math.cos(ang) * radius, 0, math.sin(ang) * radius)
            end
        end
        if inArea ~= lastIn then
            lastIn = inArea
            local col = inArea and RED or ORANGE
            for _, b in ipairs(ringBeams) do b.Color = ColorSequence.new(col) end
        end
        ringRP.FilterDescendantsInstances = {ch, ringPart}
        local hit = Workspace:Raycast(hrp.Position, Vector3.new(0, -12, 0), ringRP)
        local hum = ch:FindFirstChildOfClass("Humanoid")
        local gy = hit and hit.Position.Y or (hrp.Position.Y - (hrp.Size.Y / 2 + (hum and hum.HipHeight or 2)))
        ringPart.CFrame = CFrame.new(hrp.Position.X, gy + 0.12, hrp.Position.Z)
    end)
    if not ok then logErr(err) end
end))


