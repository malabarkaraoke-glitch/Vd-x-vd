local btnObj, btnT, btnFoundLast = nil, 0, nil
local function gc(sig)
    if not getconnections then return {} end
    local ok, l = pcall(getconnections, sig)
    return (ok and type(l) == "table") and l or {}
end
local function shown(o)
    while o and o ~= PlayerGui do
        if o:IsA("GuiObject") and not o.Visible then return false end
        if o:IsA("ScreenGui") and not o.Enabled then return false end
        o = o.Parent
    end
    return true
end
local function usable(b)
    if not (b and b.Parent) then return false end
    if not shown(b) then return false end
    local s = b.AbsoluteSize
    return s.X >= 4 and s.Y >= 4
end
local function scanBtn()
    btnT = os.clock()
    local best, bs
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d.Name == BTN_NAME and d:IsA("GuiButton") and not d:FindFirstAncestor("FallsDominion_TRIG") then
            local score = usable(d) and 100 or 0
            for _, sn in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down"}) do
                local ok, sig = pcall(function() return d[sn] end)
                if ok and sig then score = score + #gc(sig) * 10 end
            end
            if not bs or score > bs then best, bs = d, score end
        end
    end
    btnObj = best
    hookGameBtn(best)
    local found = usable(best)
    if found ~= btnFoundLast then
        btnFoundLast = found
        AddLog(found and ("[SYS] Tombol '" .. BTN_NAME .. "' ditemukan.")
            or ("[WARN] Tombol '" .. BTN_NAME .. "' tidak ketemu / tidak terlihat."), found and C_OK or C_WARN)
    end
end
local function findBtn()
    if usable(btnObj) then return btnObj end
    if os.clock() - btnT > 1 then pcall(scanBtn) end
    return usable(btnObj) and btnObj or nil
end
local function fireSignals(b)
    local groups = {{"Activated"}, {"MouseButton1Click"}, {"MouseButton1Down", "MouseButton1Up"}}
    for _, grp in ipairs(groups) do
        local n = 0
        for _, nm in ipairs(grp) do
            local ok, sig = pcall(function() return b[nm] end)
            if ok and sig then
                for _, c in ipairs(gc(sig)) do
                    if pcall(function() c:Fire() end) then n = n + 1 end
                end
            end
        end
        if n > 0 then return n end
    end
    return 0
end

-- ===== Sentuhan: satu ID tetap; Touch Up pasti dikirim =====
local TAP_ID = 8823
local tapHeld, tapX, tapY, tapT, tapGen = false, 0, 0, 0, 0
local activeToken = 0

local function releaseTouch(reason)
    if tapHeld then
        tapHeld = false
        local ok, err = pcall(function() VIM:SendTouchEvent(TAP_ID, 2, tapX, tapY) end)
        if not ok then
            AddLog("[ERROR] " .. tostring(err), C_ERR)
        elseif reason == "paksa" then
            AddLog("[WARN] Touch nyangkut! Memaksa lepas...", C_FORCE)
        elseif reason == "normal" then
            AddLog("[PARRY] Berhasil! TouchUp terkirim.", C_OK)
        end
    end
end

local function touchDown(x, y)
    releaseTouch()
    tapX, tapY = x, y
    if pcall(function() VIM:SendTouchEvent(TAP_ID, 0, x, y) end) then
        tapHeld = true
        tapT = os.clock()
        tapGen = tapGen + 1
        local g = tapGen
        task.delay(TOUCH_HOLD, function()
            if tapHeld and tapGen == g then releaseTouch("normal") end
        end)
        return true
    end
    return false
end

-- tekan lewat TRIG: sentuh titik tengah TRIG; TRIG dibuat tidak Active sesaat agar tap tembus ke tombol game
local function pressViaTrig()
    if not triggerTarget or not triggerTarget.Parent then return false end
    local p = triggerTarget.AbsolutePosition + triggerTarget.AbsoluteSize / 2
    local gi = GuiService:GetGuiInset()
    local x, y = p.X, p.Y
    local mode = Config.InsetMode
    if mode == "auto" then
        local sg = triggerTarget:FindFirstAncestorOfClass("ScreenGui")
        y = y + ((sg and sg.IgnoreGuiInset) and 0 or gi.Y)
    elseif mode == "xy" then
        x, y = x + gi.X, y + gi.Y
    end
    local cam = Workspace.CurrentCamera
    if cam then
        local vs = cam.ViewportSize
        if x < 0 or y < 0 or x > vs.X or y > vs.Y then return false end
    end
    local trig = triggerTarget
    trig.Active = false
    activeToken = activeToken + 1
    local tk = activeToken
    task.delay(TOUCH_HOLD + 0.06, function()
        if tk == activeToken and trig and trig.Parent then trig.Active = not Config.TrigLocked end
    end)
    if touchDown(x, y) then return true end
    trig.Active = not Config.TrigLocked
    return false
end

