local CONFIG_FILE = "FallConfig.json"
local SAVE_KEYS = {
    "AutoParryEnabled", "ParryRadius", "AreaEnabled", "FaceEnabled", "FaceCamEnabled", "PressMode", "InsetMode",
    "TrigShow", "TrigSize", "TrigLocked",
    "AutoSkillEnabled", "ESPEnabled", "FullbrightEnabled", "NoclipEnabled", "GenEnabled",
}
local RANGE_KEYS = {ParryRadius = {4, 40}, TrigSize = {24, 160}}

local function SaveConfig()
    if not writefile then return false, "writefile tidak didukung" end
    local data = {}
    for _, k in ipairs(SAVE_KEYS) do data[k] = Config[k] end
    pcall(function() TrigPosU = triggerTarget.Position end)
    if TrigPosU then
        data.TrigPos = {TrigPosU.X.Scale, TrigPosU.X.Offset, TrigPosU.Y.Scale, TrigPosU.Y.Offset}
    end
    local ok, err = pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(data)) end)
    return ok, err
end

local function LoadConfig()
    if not (readfile and isfile) then return false, "readfile tidak didukung" end
    local okE, exists = pcall(isfile, CONFIG_FILE)
    if not okE or not exists then return false, "File belum ada" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if not ok or type(data) ~= "table" then return false, "File rusak" end
    for _, k in ipairs(SAVE_KEYS) do
        local v = data[k]
        if v ~= nil and type(v) == type(Config[k]) then
            local r = RANGE_KEYS[k]
            if r then v = math.clamp(v, r[1], r[2]) end
            if k == "PressMode" and v ~= "trig" and v ~= "sinyal" then v = Config[k] end
            if k == "InsetMode" and v ~= "auto" and v ~= "nol" and v ~= "xy" then v = Config[k] end
            Config[k] = v
        end
    end
    local tp = data.TrigPos
    if type(tp) == "table" and type(tp[1]) == "number" and type(tp[2]) == "number"
        and type(tp[3]) == "number" and type(tp[4]) == "number" then
        TrigPosU = UDim2.new(tp[1], tp[2], tp[3], tp[4])
    end
    return true
end

