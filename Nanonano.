-- jarak jangkau: diperluas sesuai kecepatan killer dan ping
local function reachOf(kh, flat)
    local ping = 0
    pcall(function() ping = LocalPlayer:GetNetworkPing() end)
    local radius = Config.ParryRadius
    local reach = radius
    if flat.Magnitude > 0.5 then
        local vel = kh.AssemblyLinearVelocity
        local closing = Vector3.new(vel.X, 0, vel.Z):Dot(-flat.Unit)
        if closing > 0 then
            reach = radius + math.min(10, closing * (math.clamp(ping, 0, 0.5) + 0.3))
        end
    end
    return reach
end

-- catatan: cek area berbasis JARAK (360 derajat), jadi killer di belakang tetap terdeteksi
local function killerInArea(pl)
    local myHrp = getHRP(LocalPlayer)
    local ch = pl.Character
    local kh = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (myHrp and kh) then return false end
    local mp = myHrp.Position
    if math.abs(kh.Position.Y - mp.Y) > 10 then return false end
    local flat = Vector3.new(kh.Position.X - mp.X, 0, kh.Position.Z - mp.Z)
    return flat.Magnitude <= reachOf(kh, flat)
end

-- putar karakter + kamera SEKALI menghadap killer terdekat di area (tidak mengunci, bisa langsung lari)
local function faceKiller()
    local myHrp = getHRP(LocalPlayer)
    if not myHrp then return end
    local best, bd
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and isKiller(pl) and killerInArea(pl) then
            local kh = getHRP(pl)
            if kh then
                local d = (kh.Position - myHrp.Position).Magnitude
                if not bd or d < bd then best, bd = kh, d end
            end
        end
    end
    if not best then return end
    local mp, kp = myHrp.Position, best.Position
    local target = Vector3.new(kp.X, mp.Y, kp.Z)
    if (target - mp).Magnitude < 0.5 then return end
    myHrp.CFrame = CFrame.lookAt(mp, target)
    -- kamera ikut menghadap killer
    if Config.FaceCamEnabled then
