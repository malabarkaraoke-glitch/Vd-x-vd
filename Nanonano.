--==============================================================
local GEN_RANGE = 14        -- jarak maksimal ke generator (studs)
local GEN_INTERVAL = 0.3    -- jeda antar percobaan (detik)
local genList, genListT, lastGen, genBusy = {}, 0, 0, false
local lastGenState = nil

local function refreshGens()
    genListT = os.clock()
    genList = {}
    local map = Workspace:FindFirstChild("Map")
    if not map then return end
    for _, o in ipairs(map:GetDescendants()) do
        if o.Name == "Generator" and (o:IsA("Model") or o:IsA("BasePart")) then
            genList[#genList + 1] = o
        end
    end
end

local function genPos(gen)
    if gen:IsA("Model") then
        local ok, cf = pcall(function() return gen:GetPivot() end)
        if ok then return cf.Position end
    end
    local p = gen:IsA("BasePart") and gen or gen:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position
end

local function genPrompt(gen)
    for _, d in ipairs(gen:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then return d end
    end
end

local function nearestGen()
    local hrp = getHRP(LocalPlayer)
    if not hrp then return nil, math.huge end
    if os.clock() - genListT > 5 then refreshGens() end
    local best, bd = nil, math.huge
    for _, g in ipairs(genList) do
        if g.Parent then
            local gp = genPos(g)
            if gp then
                local d = (gp - hrp.Position).Magnitude
                if d < bd then best, bd = g, d end
            end
        end
    end
    return best, bd
end

local function activatePrompt(pr)
    pcall(function() pr.HoldDuration = 0 end)
    if fireproximityprompt then
        local ok = pcall(fireproximityprompt, pr)
        if ok then return true end
    end
    -- cadangan: simulasi tahan prompt
    local ok = pcall(function() pr:InputHoldBegin() end)
    if ok then
        task.delay(0.15, function() pcall(function() pr:InputHoldEnd() end) end)
        return true
    end
    return false
end

track(RunService.Heartbeat:Connect(function()
    if not Config.GenEnabled then return end
    if genBusy or os.clock() - lastGen < GEN_INTERVAL then return end
    if not isSurvivor() or selfBad() then return end
    lastGen = os.clock()
    genBusy = true
    local ok, err = pcall(function()
        local g, d = nearestGen()
        if g and d <= GEN_RANGE then
            local pr = genPrompt(g)
            if pr then
                if lastGenState ~= "fire" then
                    lastGenState = "fire"
                    AddLog("[GEN] Memperbaiki generator (" .. math.floor(d) .. " studs).", C_OK)
                end
                activatePrompt(pr)
            elseif lastGenState ~= "noprompt" then
                lastGenState = "noprompt"
                AddLog("[GEN] Generator dekat tapi tidak ada ProximityPrompt aktif.", C_WARN)
            end
        else
            lastGenState = nil
        end
    end)
    genBusy = false
    if not ok then logErr(err) end
end))

