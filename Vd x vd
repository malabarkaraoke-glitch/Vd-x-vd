local gameHitT, hookedBtn = 0, nil
local function hookGameBtn(b)
    if not b or b == hookedBtn then return end
    hookedBtn = b
    track(b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            gameHitT = os.clock()
        end
    end))
end

local btnObj, btnT, btnFoundLast = nil, 0, nil
local function gc(sig)
    if not getconnections then return {} end
    local ok, l = pcall(getconnections, sig)
    return (ok and type(l) == "table") and l or {}
end
local function shown(o)
    while o and o ~= pg do
        if o:IsA("GuiObject") and not o.Visible then return false end
        if o:IsA("ScreenGui") and not o.Enabled then return false end
        o = o.Parent
    end
    return true
end
local function usable(b)
    if not (b and b.Parent) then return false end
    if not shown(b) then return false end
    local s = b.AbsoluteSize
    return s.X >= 4 and s.Y >= 4
end
local function scanBtn()
    btnT = os.clock()
    local best, bs
    for _, d in ipairs(pg:GetDescendants()) do
        if d.Name == BTN_NAME and d:IsA("GuiButton") and not d:FindFirstAncestor("PANEL_ONOFF") then
            local score = usable(d) and 100 or 0
            for _, sn in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down"}) do
                local ok, sig = pcall(function() return d[sn] end)
                if ok and sig then score = score + #gc(sig) * 10 end
            end
            if not bs or score > bs then best, bs = d, score end
        end
    end
    btnObj = best
    hookGameBtn(best)
    local found = usable(best)
    if found ~= btnFoundLast then
        btnFoundLast = found
        AddLog(found and ("[SYS] Tombol '" .. BTN_NAME .. "' ditemukan.")
            or ("[WARN] Tombol '" .. BTN_NAME .. "' tidak ketemu / tidak terlihat."), found and C_OK or C_WARN)
    end
end
local function findBtn()
    if usable(btnObj) then return btnObj end
    if os.clock() - btnT > 1 then pcall(scanBtn) end
    return usable(btnObj) and btnObj or nil
end
local function fireSignals(b)
    local groups = {{"Activated"}, {"MouseButton1Click"}, {"MouseButton1Down", "MouseButton1Up"}}
    for _, grp in ipairs(groups) do
        local n = 0
        for _, nm in ipairs(grp) do
            local ok, sig = pcall(function() return b[nm] end)
            if ok and sig then
                for _, c in ipairs(gc(sig)) do
                    if pcall(function() c:Fire() end) then n = n + 1 end
                end
            end
        end
        if n > 0 then return n end
    end
    return 0
end

-- ===== Sentuhan: satu ID tetap; Touch Up pasti dikirim =====
local TAP_ID = 8823
local tapHeld, tapX, tapY, tapT, tapGen = false, 0, 0, 0, 0
local activeToken = 0

local function releaseTouch(reason)
    if tapHeld then
        tapHeld = false
        local ok, err = pcall(function() VIM:SendTouchEvent(TAP_ID, 2, tapX, tapY) end)
        if not ok then
            AddLog("[ERROR] " .. tostring(err), C_ERR)
        elseif reason == "paksa" then
            AddLog("[WARN] Touch nyangkut! Memaksa lepas...", C_FORCE)
        elseif reason == "normal" then
            AddLog("[PARRY] Berhasil! TouchUp terkirim.", C_OK)
        end
    end
end

local function touchDown(x, y)
    releaseTouch()
    tapX, tapY = x, y
    if pcall(function() VIM:SendTouchEvent(TAP_ID, 0, x, y) end) then
        tapHeld = true
        tapT = os.clock()
        tapGen = tapGen + 1
        local g = tapGen
        task.delay(TOUCH_HOLD, function()
            if tapHeld and tapGen == g then releaseTouch("normal") end
        end)
        return true
    end
    return false
end

-- tekan lewat TRIG: sentuh titik tengah TRIG; TRIG dibuat tidak Active sesaat agar tap tembus ke tombol game
local function pressViaTrig()
    if not trigBtn or not trigBtn.Parent then return false end
    local p = trigBtn.AbsolutePosition + trigBtn.AbsoluteSize / 2
    local gi = GuiService:GetGuiInset()
    local x, y = p.X, p.Y
    if insetMode == "auto" then
        local sg = trigBtn:FindFirstAncestorOfClass("ScreenGui")
        y = y + ((sg and sg.IgnoreGuiInset) and 0 or gi.Y)
    elseif insetMode == "xy" then
        x, y = x + gi.X, y + gi.Y
    end
    local cam = workspace.CurrentCamera
    if cam then
        local vs = cam.ViewportSize
        if x < 0 or y < 0 or x > vs.X or y > vs.Y then return false end
    end
    trigBtn.Active = false
    activeToken = activeToken + 1
    local tk = activeToken
    task.delay(TOUCH_HOLD + 0.06, function()
        if tk == activeToken and trigBtn and trigBtn.Parent then trigBtn.Active = not trigLocked end
    end)
    if touchDown(x, y) then return true end
    trigBtn.Active = not trigLocked
    return false
end

-- MODE TRIG   : sentuh TRIG.
-- MODE SINYAL : fire sinyal tombol game DAN sentuh TRIG (dua-duanya).
local function pressParryRaw()
    local touched = false
    if UIS.TouchEnabled then
        touched = pressViaTrig()
    end
    local sig = 0
    if pressMode == "sinyal" or not UIS.TouchEnabled then
        local b = findBtn()
        sig = b and fireSignals(b) or 0
    end
    return touched or sig > 0
end

local function pressParry()
    local ok, res = pcall(pressParryRaw)
    if not ok then
        AddLog("[ERROR] " .. tostring(res), C_ERR)
        releaseTouch()
        return false
    end
    return res
end

local DOWN = {"downed", "knocked", "dying", "crawl", "incap"}
local function selfBad()
    local ch = lp.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    if ch:GetAttribute("IsHooked") == true then return true end
    for k, v in pairs(ch:GetAttributes()) do
        if v == true then
            local l = lower(k)
            if not string.find(l, "countdown", 1, true) then
                for _, w in ipairs(DOWN) do
                    if string.find(l, w, 1, true) then return true end
                end
            end
        end
    end
    return false
end

local playDone = setmetatable({}, {__mode = "k"})
local lastTP = setmetatable({}, {__mode = "k"})
local hooked = setmetatable({}, {__mode = "k"})
local seenUnknown = {}
local inArea, wasIn = false, false

-- jarak jangkau: diperluas sesuai kecepatan killer dan ping
local function reachOf(kh, flat)
    local ping = 0
    pcall(function() ping = lp:GetNetworkPing() end)
    local reach = radius
    if flat.Magnitude > 0.5 then
        local vel = kh.AssemblyLinearVelocity
        local closing = Vector3.new(vel.X, 0, vel.Z):Dot(-flat.Unit)
        if closing > 0 then
            reach = radius + math.min(10, closing * (math.clamp(ping, 0, 0.5) + 0.3))
        end
    end
    return reach
end

-- catatan: cek area berbasis JARAK (360 derajat), jadi killer di belakang tetap terdeteksi
local function killerInArea(pl)
    local myHrp = getHRP(lp)
    local ch = pl.Character
    local kh = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (myHrp and kh) then return false end
    local mp = myHrp.Position
    if math.abs(kh.Position.Y - mp.Y) > 10 then return false end
    local flat = Vector3.new(kh.Position.X - mp.X, 0, kh.Position.Z - mp.Z)
    return flat.Magnitude <= reachOf(kh, flat)
end

-- putar karakter + kamera SEKALI menghadap killer terdekat di area (tidak mengunci, bisa langsung lari)
local function faceKiller()
    local myHrp = getHRP(lp)
    if not myHrp then return end
    local best, bd
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and isKiller(pl) and killerInArea(pl) then
            local kh = getHRP(pl)
            if kh then
                local d = (kh.Position - myHrp.Position).Magnitude
                if not bd or d < bd then best, bd = kh, d end
            end
        end
    end
    if not best then return end
    local mp, kp = myHrp.Position, best.Position
    local target = Vector3.new(kp.X, mp.Y, kp.Z)
    if (target - mp).Magnitude < 0.5 then return end
    myHrp.CFrame = CFrame.lookAt(mp, target)
    -- kamera ikut menghadap killer
    if State.FaceCam then
        local cam = workspace.CurrentCamera
        if cam then
            local cp = cam.CFrame.Position
            cam.CFrame = CFrame.lookAt(cp, kp)
        end
    end
end

local lastTryLog, lastFailLog = 0, 0
local function tryParry()
    local now = os.clock()
    if now - lastParry < PARRY_GAP then return false end
    if selfBad() then return false end
    -- hadap killer dulu (juga kalau killer di belakang), baru tekan parry
    if State.Face then pcall(faceKiller) end
    if now - lastTryLog > 0.4 then
        lastTryLog = now
        AddLog("[PARRY] Mencoba menekan (" .. string.upper(pressMode) .. ")...", C_INFO)
    end
    if not pressParry() then
        if now - lastFailLog > 1 then
            lastFailLog = now
            AddLog("[WARN] Tekan gagal (TRIG hilang / di luar layar / tombol tidak ketemu).", C_WARN)
        end
        return false
    end
    lastParry = now
    if pressMode == "sinyal" then
        AddLog("[PARRY] Sinyal + TRIG terkirim.", C_OK)
    end
    if UIS.TouchEnabled and hookedBtn then
        local tp = tapT
        task.delay(0.12, function()
            if gameHitT >= tp then
                AddLog("[TRIG] Sentuhan diterima tombol game.", C_OK)
            elseif pressMode ~= "sinyal" then
                AddLog("[TRIG] Sentuhan TIDAK sampai ke tombol game!", C_ERR)
            end
        end)
    end
    if DOUBLE_PRESS then
        task.spawn(function()
            task.wait(TOUCH_HOLD + 0.01)
            if State.Parry then pressParry() end
        end)
    end
    return true
end

local function handleTrack(t)
    if t.Looped or playDone[t] then return end
    local id = t.Animation and t.Animation.AnimationId
    if not id then return end
    local tp = t.TimePosition
    if not attackAnims[id] then
        if tp <= ANIM_MAX_TP and not seenUnknown[id] then
            seenUnknown[id] = true
            AddLog("[ANIM] Tak dikenal: " .. (string.match(id, "%d+") or id), C_WARN)
        end
        return
    end
    if tp > ANIM_MAX_TP then return end
    if tryParry() then playDone[t] = true end
end

local lastErrLog = 0
local function logErr(err)
    local now = os.clock()
    if now - lastErrLog > 1 then
        lastErrLog = now
        AddLog("[ERROR] " .. tostring(err), C_ERR)
    end
end

local function parryStep()
    -- penjaga: sentuhan tidak boleh nyangkut
    if tapHeld and os.clock() - tapT > TOUCH_HOLD + 0.05 then releaseTouch("paksa") end
    inArea = false
    if not State.Parry then wasIn = false return end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and isKiller(pl) and pl.Character then
            local ch = pl.Character
            local an = ch:FindFirstChildWhichIsA("Animator", true)
            if an and not hooked[an] then
                hooked[an] = true
                track(an.AnimationPlayed:Connect(function(tk)
                    local ok, err = pcall(function()
                        playDone[tk] = nil
                        lastTP[tk] = 0
                        if State.Parry and killerInArea(pl) then handleTrack(tk) end
                    end)
                    if not ok then logErr(err) end
                end))
            end
            if killerInArea(pl) then
                inArea = true
                local src = an or ch:FindFirstChildOfClass("Humanoid")
                if src then
                    for _, t in ipairs(src:GetPlayingAnimationTracks()) do
                        local tp = t.TimePosition
                        if tp < (lastTP[t] or 0) - 0.05 then playDone[t] = nil end
                        lastTP[t] = tp
                        handleTrack(t)
                    end
                end
            end
        end
    end
    if inArea and not wasIn then
        AddLog("[SYS] Killer mendekat!", C_WARN)
    end
    wasIn = inArea
end

track(RunService.Stepped:Connect(function()
    local ok, err = pcall(parryStep)
    if not ok then logErr(err) end
end))

