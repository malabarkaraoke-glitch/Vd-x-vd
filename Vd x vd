local TouchID = 8822
local ActionPath = "Survivor-mob.Controls.action.check"
local isProcessingHit = false

local function getActionTarget()
    local cur = pg
    for seg in string.gmatch(ActionPath, "[^%.]+") do
        cur = cur and cur:FindFirstChild(seg)
    end
    return cur
end

local function tapSkill()
    local b = getActionTarget()
    if b and b:IsA("GuiObject") then
        local p, s, i = b.AbsolutePosition, b.AbsoluteSize, GuiService:GetGuiInset()
        local cx, cy = p.X + (s.X / 2) + i.X, p.Y + (s.Y / 2) + i.Y
        pcall(function()
            VIM:SendTouchEvent(TouchID, 0, cx, cy)
            task.wait(0.002)
            VIM:SendTouchEvent(TouchID, 2, cx, cy)
        end)
    else
        pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.002)
            VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end
end

local function isSurvivor()
    local team = lp.Team
    local n = team and lower(team.Name) or ""
    return string.find(n, "survivor", 1, true) ~= nil
end

track(RunService.Heartbeat:Connect(function()
    if not State.Skill then isProcessingHit = false return end
    if not isSurvivor() then return end
    local prompt = pg:FindFirstChild("SkillCheckPromptGui")
    local check = prompt and prompt:FindFirstChild("Check")
    if not (check and check.Visible) then isProcessingHit = false return end
    local line, goal = check:FindFirstChild("Line"), check:FindFirstChild("Goal")
    if not (line and goal) then return end
    local lr, gr = line.Rotation % 360, goal.Rotation % 360
    local ss, se = (gr + 102) % 360, (gr + 116) % 360
    local inZone = (ss > se and (lr >= ss or lr <= se)) or (lr >= ss and lr <= se)
    if not inZone then isProcessingHit = false return end
    if not isProcessingHit then
        isProcessingHit = true
        task.spawn(tapSkill)
    end
end))

